(* Start_Cycle AND NOT Tn_Level_High → Coil: Tn_Valve_Inlet *)

FUNCTION_BLOCK TankCycle_FB_LD
VAR
    Cycle_Active : BOOL := FALSE;
    Fill_Complete : BOOL := FALSE;
    Mix_Complete : BOOL := FALSE;
    Heat_Complete : BOOL := FALSE;
    Discharge_Complete : BOOL := FALSE;
    T1_Cycle_Complete : BOOL := FALSE;
    T1_Temp_Setpoint_AT : INT := 60;
    T1_Level_High : BOOL;
    Start_Cycle : BOOL;
    T1_Valve_Inlet : BOOL;
END_VAR
VAR_INPUT
END_VAR


